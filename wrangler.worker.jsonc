{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clima-sur-alertas",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-28",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clima-sur-alerts",
      "database_id": "a4166d6e-a2ba-46b0-b60c-08ca979cce7f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WHATSAPP_ENABLED": "false",
    "META_GRAPH_API_VERSION": "REPLACE_WITH_SUPPORTED_GRAPH_API_VERSION",
    "WHATSAPP_TEMPLATE_NAME": "clima_sur_alerta",
    "WHATSAPP_TEMPLATE_LANGUAGE": "es_PE"
  }
}
